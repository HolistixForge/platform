# Clean stale TypeScript build artifacts to prevent tsc-files errors
echo "🧹 Cleaning stale TypeScript artifacts..."
find packages -type f -path "*/out-tsc/*.d.ts" -delete 2>/dev/null || true
rm -f tsconfig.*.tsbuildinfo 2>/dev/null || true

# Run linter on staged files
npx lint-staged

# Run tests for affected packages based on uncommitted changes
echo "Running tests for affected packages..."
npx nx affected:test --uncommitted --parallel=3 --maxParallel=3

# Check if tests passed
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Commit aborted."
  exit 1
fi

echo "✅ All checks passed!"

