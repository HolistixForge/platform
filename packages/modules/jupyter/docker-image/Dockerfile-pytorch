# Jupyter PyTorch Notebook - User Container Image
#
# Jupyter notebook with PyTorch (CUDA) and web terminal support.
#
# Build (from repo root):
#   docker build -t holistixforge/jupyter-pytorch:latest -f packages/modules/jupyter/docker-image/Dockerfile-pytorch packages/modules/jupyter/docker-image/
#
# Requires:
#   - holistixforge/bootstrap-tools:latest (build from user-containers/docker-images/base/)
#   - holistixforge/ttyd-tools:latest (build from user-containers/docker-images/ttyd/)
#
# Reference: https://github.com/jupyter/docker-stacks/blob/main/images/pytorch-notebook/Dockerfile

# Stage 1: Get shared Holistix bootstrap tools
FROM holistixforge/bootstrap-tools:latest AS tools

# Stage 2: Get ttyd tools layer
FROM holistixforge/ttyd-tools:latest AS ttyd

# Stage 3: Build the actual image
FROM quay.io/jupyter/scipy-notebook:lab-4.2.0

USER root

# Install required packages (Debian-based image)
# Note: tini is already included in jupyter base images
RUN apt-get update --yes && apt-get install --yes --no-install-recommends \
    jq \
    curl \
    openvpn \
    iputils-ping \
    pciutils \
  && rm -rf /var/lib/apt/lists/*

# Copy shared Holistix bootstrap tools from tools stage
COPY --from=tools /holistix/ /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh

# Copy ttyd tools from ttyd stage
COPY --from=ttyd /holistix/ttyd/ /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh

# Install ttyd and tmux using the distro-specific installer (Debian)
RUN /usr/local/bin/install-ttyd-debian.sh

# Install PyTorch and collaboration extension as jovyan user
USER ${NB_UID}

# Fix: https://github.com/hadolint/hadolint/wiki/DL4006
# Fix: https://github.com/koalaman/shellcheck/wiki/SC3014
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

RUN pip install --no-cache-dir jupyter-collaboration

USER root

# Copy container-specific files
COPY ./page_config.json /etc/jupyter/labconfig/
COPY ./activity-server.py ./hub-oauth-proxy.py ./container-entrypoint.sh /usr/local/bin/
RUN chmod 755 /etc/jupyter/labconfig/page_config.json \
    /usr/local/bin/activity-server.py \
    /usr/local/bin/hub-oauth-proxy.py \
    /usr/local/bin/container-entrypoint.sh

# Configure container entrypoint
# ENTRYPOINT was ["tini", "-g", "--", "start.sh"]
# CMD was ["start-notebook.py"] (/usr/local/bin/start-notebook.py)

ENTRYPOINT ["tini", "-g", "--", "container-entrypoint.sh"]
CMD [""]
