{
  "openapi": "3.0.1",
  "info": {
    "title": "Gateway API (Collaboration & Events)",
    "version": "2.0",
    "description": "Organization-level gateway for collaborative state and OAuth"
  },
  "paths": {
    "/collab/ping": {
      "get": {
        "summary": "Health check",
        "tags": ["Collab"],
        "responses": {
          "200": { "$ref": "#/components/responses/empty" }
        }
      }
    },
    "/collab/event": {
      "post": {
        "summary": "Process collaborative event",
        "tags": ["Collab"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string" }
                    },
                    "additionalProperties": true,
                    "required": ["type"]
                  }
                },
                "required": ["event"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/empty" },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/collab/start": {
      "post": {
        "summary": "Trigger gateway initialization",
        "description": "Triggers gateway to fetch config from Ganymede and initialize. Public endpoint (no auth required).",
        "tags": ["Collab"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/empty" },
          "404": {
            "description": "Gateway not allocated to any organization",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/collab/room-id": {
      "get": {
        "summary": "Get room ID for a project",
        "description": "Returns the room ID for a specific project. Requires project access permission.",
        "tags": ["Collab"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "query",
            "name": "project_id",
            "description": "Project ID (optional if provided in JWT)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "string", "format": "uuid" }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/collab/vpn-config": {
      "get": {
        "summary": "Get VPN configuration",
        "tags": ["VPN"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" }
        ],
        "responses": {
          "200": {
            "description": "VPN configuration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "ca": { "type": "string" },
                        "cert": { "type": "string" },
                        "key": { "type": "string" },
                        "ta": { "type": "string" },
                        "port": { "type": "number" },
                        "config": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/permissions": {
      "get": {
        "summary": "Get all compiled permissions from all modules",
        "description": "Returns all permissions registered by modules. Requires gateway:[permissions:*]:read permission.",
        "tags": ["Permissions"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" }
        ],
        "responses": {
          "200": {
            "description": "List of all permissions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "permissions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/permission_definition"
                      }
                    }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/permissions/projects/{project_id}": {
      "get": {
        "summary": "[DEPRECATED] Get user permissions for a project",
        "description": "⚠️ DEPRECATED: Use GET /users/:user_id/roles instead. This endpoint is not compatible with RBAC and returns HTTP 410.",
        "deprecated": true,
        "tags": ["Permissions"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Project ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User permissions for project",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "permissions": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "description": "Map of user_id to permissions array"
                    }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/permissions/projects/{project_id}/users/{user_id}": {
      "patch": {
        "summary": "[DEPRECATED] Update user permissions for a project",
        "description": "⚠️ DEPRECATED: Use POST /users/:user_id/roles to assign roles instead. Direct permission assignment bypasses RBAC. Returns HTTP 410.",
        "deprecated": true,
        "tags": ["Permissions"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Project ID"
          },
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "permissions": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Array of permission strings"
                  }
                },
                "required": ["permissions"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Permissions updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/roles": {
      "get": {
        "summary": "List all roles",
        "description": "Returns all roles (system + custom). Requires gateway:roles:read permission.",
        "tags": ["RBAC"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" }
        ],
        "responses": {
          "200": {
            "description": "List of roles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "roles": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/role" }
                    }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      },
      "post": {
        "summary": "Create custom role",
        "description": "Creates a new custom role. Requires gateway:roles:write permission.",
        "tags": ["RBAC"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role_name": {
                    "type": "string",
                    "description": "Unique role identifier (e.g., 'project-developer')"
                  },
                  "display_name": {
                    "type": "string",
                    "description": "Human-readable name"
                  },
                  "description": {
                    "type": "string",
                    "description": "Role description"
                  },
                  "permissions": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Array of permission strings"
                  },
                  "scope": {
                    "type": "string",
                    "enum": ["org", "project"],
                    "description": "Role scope level"
                  }
                },
                "required": [
                  "role_name",
                  "display_name",
                  "permissions",
                  "scope"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Role created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/role" }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/roles/{role_id}": {
      "get": {
        "summary": "Get role by ID",
        "description": "Returns a specific role. Requires gateway:roles:read permission.",
        "tags": ["RBAC"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "role_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Role details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/role" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/errors" },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      },
      "patch": {
        "summary": "Update custom role",
        "description": "Updates a custom role. Cannot modify system roles. Requires gateway:roles:write permission.",
        "tags": ["RBAC"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "role_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "display_name": { "type": "string" },
                  "description": { "type": "string" },
                  "permissions": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/role" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/errors" },
          "404": { "$ref": "#/components/responses/errors" },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      },
      "delete": {
        "summary": "Delete custom role",
        "description": "Deletes a custom role and removes it from all users. Cannot delete system roles. Requires gateway:roles:write permission.",
        "tags": ["RBAC"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "role_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Role deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/errors" },
          "404": { "$ref": "#/components/responses/errors" },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/users/{user_id}/roles": {
      "get": {
        "summary": "Get user's roles",
        "description": "Returns user's organization and project roles. Requires gateway:roles:read permission.",
        "tags": ["RBAC"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "in": "query",
            "name": "project_id",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Optional project ID to include project-specific roles"
          }
        ],
        "responses": {
          "200": {
            "description": "User roles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "org_roles": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/role" }
                    },
                    "project_roles": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/role" }
                      },
                      "description": "Map of project_id to roles array"
                    }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      },
      "post": {
        "summary": "Assign role to user",
        "description": "Assigns a role to a user at org or project level. Requires gateway:roles:write permission.",
        "tags": ["RBAC"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Role ID to assign"
                  },
                  "scope": {
                    "type": "string",
                    "enum": ["org", "project"],
                    "description": "Assignment scope"
                  },
                  "project_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Required if scope is 'project'"
                  }
                },
                "required": ["role_id", "scope"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role assigned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/errors" },
          "403": { "$ref": "#/components/responses/errors" },
          "404": { "$ref": "#/components/responses/errors" },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/users/{user_id}/roles/{role_id}": {
      "delete": {
        "summary": "Remove role from user",
        "description": "Removes a role from a user. Requires gateway:roles:write permission.",
        "tags": ["RBAC"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "in": "path",
            "name": "role_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "in": "query",
            "name": "project_id",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Required for project-scoped roles"
          }
        ],
        "responses": {
          "200": {
            "description": "Role removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/errors" },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/members/projects/{project_id}/users": {
      "post": {
        "summary": "Add member to project",
        "description": "Adds a user to a project with specified roles. Gateway-orchestrated member management. Requires project:*:admin permission.",
        "tags": ["Members"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "User ID (must be org member)"
                  },
                  "role_ids": {
                    "type": "array",
                    "items": { "type": "string", "format": "uuid" },
                    "description": "Project-scoped roles to assign"
                  }
                },
                "required": ["user_id", "role_ids"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Member added",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/errors" },
          "403": { "$ref": "#/components/responses/errors" },
          "404": { "$ref": "#/components/responses/errors" },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/members/projects/{project_id}/users/{user_id}": {
      "delete": {
        "summary": "Remove member from project",
        "description": "Removes a user from a project (removes all project roles). Requires project:*:admin permission.",
        "tags": ["Members"],
        "parameters": [
          { "$ref": "#/components/parameters/headers_authorization" },
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Member removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/errors" },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/oauth/authorize": {
      "get": {
        "summary": "OAuth2 authorization endpoint",
        "description": "OAuth2 authorization code flow",
        "tags": ["OAuth"],
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["code"] }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "description": "OAuth client ID" }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uri" }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/headers_authorization" }
        ],
        "responses": {
          "302": {
            "description": "Redirect to redirect_uri with authorization code",
            "headers": {
              "Location": {
                "schema": { "type": "string", "format": "uri" },
                "description": "redirect_uri?code=...&state=..."
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "summary": "OAuth2 token endpoint)",
        "description": "Exchange authorization code for access token, or refresh access token.",
        "tags": ["OAuth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": ["authorization_code", "refresh_token"]
                  },
                  "code": {
                    "type": "string",
                    "description": "Authorization code (for authorization_code grant)"
                  },
                  "refresh_token": {
                    "type": "string",
                    "description": "Refresh token (for refresh_token grant)"
                  },
                  "client_id": {
                    "type": "string",
                    "description": "OAuth client ID"
                  },
                  "client_secret": {
                    "type": "string",
                    "description": "OAuth client secret"
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "Must match redirect_uri from authorization request"
                  }
                },
                "required": ["grant_type", "client_id", "client_secret"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "token_type": { "type": "string", "example": "Bearer" },
                    "expires_in": { "type": "integer" },
                    "refresh_token": { "type": "string" },
                    "scope": { "type": "string" }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" },
          "5XX": { "$ref": "#/components/responses/errors" }
        }
      }
    },
    "/oauth/authenticate": {
      "post": {
        "summary": "OAuth2 token authentication endpoint",
        "description": "Validate OAuth2 access token.",
        "tags": ["OAuth"],
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^Bearer\\s[-A-Za-z0-9_+./]*={0,3}$"
            },
            "description": "OAuth2 access token (Bearer token)"
          }
        ],
        "responses": {
          "200": {
            "description": "Token validated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": { "type": "string", "format": "uuid" },
                    "scope": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "client_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/errors" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "empty": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      },
      "errors": {
        "description": "Error response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/errors" }
          }
        }
      }
    },
    "schemas": {
      "errors": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": { "type": "string" },
                "public": { "type": "boolean" }
              }
            }
          }
        }
      },
      "permission_definition": {
        "type": "object",
        "properties": {
          "permission": {
            "type": "string",
            "description": "Full permission string (e.g., 'user-containers:[user-container:*]:create')"
          },
          "module": {
            "type": "string",
            "description": "Module name that registered this permission"
          },
          "resourcePath": {
            "type": "string",
            "description": "Resource path (e.g., 'user-container:*' or 'user-container:*/service:*')"
          },
          "action": {
            "type": "string",
            "description": "Action (e.g., 'create', 'delete', 'read')"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description"
          }
        },
        "required": ["permission", "module", "resourcePath", "action"]
      },
      "role": {
        "type": "object",
        "properties": {
          "role_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique role identifier"
          },
          "role_name": {
            "type": "string",
            "description": "Role name (e.g., 'org:owner', 'project-developer')"
          },
          "display_name": {
            "type": "string",
            "description": "Human-readable name"
          },
          "description": {
            "type": "string",
            "description": "Role description"
          },
          "permissions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of permission strings (supports wildcards)"
          },
          "scope": {
            "type": "string",
            "enum": ["org", "project"],
            "description": "Org-level (applies to all projects) or project-specific"
          },
          "system": {
            "type": "boolean",
            "description": "Whether this is a system-defined role"
          },
          "immutable": {
            "type": "boolean",
            "description": "Whether this role can be modified or deleted"
          }
        },
        "required": [
          "role_id",
          "role_name",
          "display_name",
          "permissions",
          "scope",
          "system",
          "immutable"
        ]
      }
    },
    "parameters": {
      "headers_authorization": {
        "in": "header",
        "name": "authorization",
        "description": "JWT access token",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^(?:token\\s)?[-A-Za-z0-9_+./]*={0,3}$"
        }
      }
    }
  }
